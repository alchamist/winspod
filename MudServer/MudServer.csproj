<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MudServer</RootNamespace>
    <AssemblyName>MudServer</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Legacy hand-written Properties\AssemblyInfo.cs is kept for its product/copyright
         attributes, so let the SDK skip generating a second one. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keeps the legacy System.Configuration.ApplicationSettingsBase-based
         AppSettings.Designer.cs / app.config working unmodified on modern .NET. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game data files the server reads at runtime (help text, MOTDs, command table). -->
    <Content Include="files\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="help\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="commands\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="AppSettings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
      <LastGenOutput>AppSettings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
